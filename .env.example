# Copia questo file in .env e scegli valori tuoi. Il file .env non va mai nella repository.
POSTGRES_USER=effata
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=effata

# Usata da Prisma (apps/api). Deve corrispondere ai valori qui sopra.
DATABASE_URL=postgresql://effata:cambiami@localhost:5432/effata?schema=public

# Porta dell'API (apps/api)
PORT=3000
NODE_ENV=development
